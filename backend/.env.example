# === Required ===
# JWT secret key for signing authentication tokens (min 32 chars recommended)
JWT_SECRET_KEY=

# === Optional ===
# Database URL (default: sqlite:///finance.db)
# DATABASE_URL=sqlite:///finance.db

# Upload directory for receipts (default: uploads)
# UPLOAD_DIR=uploads

# Environment: development or production (default: development)
# ENVIRONMENT=development

# OpenRouter API key for AI features
# OPENROUTER_API_KEY=your_key_here

# Frontend URL for CORS
# FRONTEND_URL=http://localhost:5173

# JWT configuration
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# Cookie configuration for JWT storage
# COOKIE_NAME=access_token
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Rate limiting (requests per 60s window)
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_UPLOAD_MAX=10
# RATE_LIMIT_AGENT_MAX=10

# Server port
# PORT=8000
